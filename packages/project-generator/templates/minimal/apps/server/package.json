{
  "name": "server",
  "private": true,
  "type": "module",
  "main": "dist/server.mjs",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch ./src/server.ts",
    "start": "node ./dist/server.mjs",
    "build": "tsdown",
    "check-types": "tsgo --noEmit",
    "lint": "eslint . --fix",
    "prettify": "prettier --write ./src/"
  },
  "prettier": "@startername/prettier-config",
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@startername/eslint-config": "workspace:*",
    "@startername/prettier-config": "workspace:*",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
