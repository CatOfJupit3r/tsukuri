{
  "name": "startername",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -f ./docker-compose.dev.yml --profile postgres up -d --wait && pnpm --parallel --filter=server --filter=web run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive --stream run test",
    "check-types": "pnpm --recursive --stream --no-bail run check-types",
    "prettify": "pnpm --recursive --stream run prettify",
    "prettier": "pnpm run prettify",
    "dev:web": "pnpm --filter=web run dev",
    "dev:server": "pnpm --filter=server run dev",
    "db:generate": "pnpm --filter=@startername/api run db:generate",
    "db:migrate": "pnpm --filter=@startername/api run db:migrate",
    "db:push": "pnpm --filter=@startername/api run db:push",
    "db:studio": "pnpm --filter=@startername/api run db:studio",
    "lint": "oxlint -c oxlint.config.mjs --fix apps packages && pnpm --recursive --no-sort --stream --no-bail run lint:eslint",
    "lint:fix": "pnpm run lint",
    "verify": "tsx scripts/verify.ts",
    "verify:styles": "tsx scripts/verify-styles.ts",
    "build:server": "pnpm --filter=server... run build",
    "create": "pnpm --filter=create-tsukuri run cli create",
    "add": "pnpm --filter=create-tsukuri run cli add",
    "remove": "pnpm --filter=create-tsukuri run cli remove",
    "sync": "pnpm --filter=create-tsukuri run sync:repo",
    "clean:modules": "tsx scripts/clean.ts",
    "prepare": "husky",
    "commit": "cz",
    "update:workspaces": "pnpm update --interactive --recursive",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@startername/lint-config": "workspace:*",
    "@types/node": "catalog:",
    "commitizen": "4.3.2",
    "cz-git": "1.13.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "6.1.3",
    "tsx": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git",
      "czConfig": "./cz.config.cjs"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0",
    "pnpm": ">=12.14.0"
  }
}
