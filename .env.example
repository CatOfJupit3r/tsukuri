# Generated by create-tsukuri from starter.json. Do not edit: changes are overwritten when modules are added or removed.

# apps/web
# Shared by the web app and the API server: the web app sends it on its own session lookups so they skip the per-address rate limit. Keep it private and identical in both.
INTERNAL_RENDER_SECRET=replace-with-a-random-render-secret-of-32-chars
VITE_HOST=localhost
VITE_PORT=3030
VITE_SERVER_URL=http://localhost:5050

# packages/api
NODE_ENV=development
# Origins allowed to send requests that change data (matched exactly, no wildcards). Leave it empty when the web app shares the API origin.
TRUSTED_ORIGINS=http://localhost:3030
REQUEST_ORIGIN_MODE=lenient
# Shared by the web app and the API server: the web app sends it on its own session lookups so they skip the per-address rate limit. Keep it private and identical in both.
INTERNAL_RENDER_SECRET=replace-with-a-random-render-secret-of-32-chars
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/startername
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-chars
# Behind a proxy that sets the real client address (for example x-forwarded-for), name that header so rate limits see it. Unset trusts no header: Node and TanStack Start use the connection address, a Worker uses cf-connecting-ip.
TRUSTED_IP_HEADER=
BETTER_AUTH_URL=http://localhost:5050
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_SESSION_STORE=database
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_USERNAME=
VALKEY_PASSWORD=
VALKEY_DB=0

# apps/server
SERVER_PORT=5050
SERVER_HOST=localhost
CORS_ORIGIN=http://localhost:3030
