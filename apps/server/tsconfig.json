{
  "extends": "@startername/swc-config/tsconfig.decorators.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["workspace-source"],
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "paths": {
      "@~/*": ["./src/*"]
    },
    "outDir": "./dist",
    "types": ["node", "vitest"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "files": ["../../packages/common/src/globals.d.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "test/**/*.ts", "test/**/*.tsx"]
}
